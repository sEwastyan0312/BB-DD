                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">;WITH SRC AS (
  SELECT
    CAST(CUSTOMER_ID AS INT) AS CustomerID,
    CAST(FULL_NAME  AS VARCHAR(200)) AS FullName,
    CAST(CITY      AS VARCHAR(100)) AS City,
    CAST(STATE AS VARCHAR(100)) AS StateName,
    CAST(ZIPCODE   AS VARCHAR(50))  AS Zipcode,
    CAST(BIRTH_DATE AS VARCHAR(100)) AS BirthDateTxt
  FROM stg_customer_w_G03
),
N AS (SELECT 1 AS n UNION ALL SELECT n+1 FROM N WHERE n &lt; 100),
CH AS (
  SELECT s.CustomerID, s.FullName, s.City, s.StateName, s.Zipcode, s.BirthDateTxt,
         SUBSTRING(s.BirthDateTxt, n.n, 1) AS ch, n.n
  FROM SRC s
  JOIN N n ON n.n &lt;= LEN(s.BirthDateTxt)
),
WHITELIST AS (
  SELECT c.CustomerID, c.FullName, c.City, c.StateName, c.Zipcode, c.BirthDateTxt,
         (SELECT '' + SUBSTRING(c2.BirthDateTxt, c2.n, 1)
          FROM CH c2
          WHERE c2.CustomerID=c.CustomerID AND c2.FullName=c.FullName
            AND c2.City=c.City AND c2.StateName=c.StateName AND c2.Zipcode=c.Zipcode
            AND SUBSTRING(c2.BirthDateTxt, c2.n, 1) LIKE '[0-9/]'
          ORDER BY c2.n FOR XML PATH(''), TYPE).value('.','VARCHAR(100)') AS BirthDateClean
  FROM CH c
  GROUP BY c.CustomerID, c.FullName, c.City, c.StateName, c.Zipcode, c.BirthDateTxt
),
PARSE AS (
  SELECT
    CustomerID, FullName, City, StateName, Zipcode,
    CAST(BirthDateClean AS VARCHAR(100)) AS BirthDateRaw,
    TRY_CONVERT(date, BirthDateClean, 101) AS BirthDateParsed
  FROM WHITELIST
)
SELECT
  CustomerID,
  FullName,
  City,
  StateName,
  CASE WHEN LEN(LTRIM(RTRIM(Zipcode))) = 4 THEN '0' + LTRIM(RTRIM(Zipcode))
       ELSE LTRIM(RTRIM(Zipcode)) END AS Zipcode,
  BirthDateRaw,
  BirthDateParsed,
  CAST('R' AS VARCHAR(1)) AS CustomerType
FROM PARSE
OPTION (MAXRECURSION 0);</property>
