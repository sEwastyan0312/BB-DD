    <DTS:Executable
      DTS:refId="Package\Carga Fact DW"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:Disabled="True"
      DTS:DTSID="{409E5CAB-2E2C-4280-ABBC-0B992011A295}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Carga Fact DW"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F8D2E1E8-48A7-4856-87AF-A08D5074A612}"
          SQLTask:SqlStatementSource="&#xA;&#xA;--Precios&#xA;drop table [bd_intermedia_2025_G06].[dbo].[Int_PreciosFinal_G06];&#xA;go&#xA;&#xA;&#xA;SELECT&#xA;    PRODUCT_ID,&#xA;    DATE AS [FROM],&#xA;    LEAD(DATE, 1) OVER (PARTITION BY PRODUCT_ID ORDER BY DATE) AS [UNTIL],&#xA;    PRICE&#xA;into Int_PreciosFinal_G06&#xA;FROM&#xA;    [dbo].[Int_Precios_G06]&#xA;ORDER BY&#xA;    PRODUCT_ID, [FROM]&#xA;&#xA;&#xA;--------------------------&#xA;--FACT&#xA;--------------------------&#xA;with CTE_Total_Facturado AS (&#xA;select v.billing_id, v.date, SUM(v.quantity) * SUM(p.PRICE) AS total_facturado&#xA;from dbo.Int_Ventas_G06 v --1.676.294&#xA;left join dbo.Int_PreciosFinal_G06 p --con inner 1.642.971 quedan sin precio&#xA;on v.product_id = p.PRODUCT_ID&#xA;and v.date &gt;= p.[FROM]&#xA;and (v.date &lt; p.UNTIL or p.UNTIL is null)&#xA;group by v.billing_id, v.date&#xA;)&#xA;,&#xA;CTE_Descuentos AS (&#xA;select v.billing_id, v.date, v.total_facturado, isnull(MAX(d.PERCENTAGE/100.00),0.00) AS descuento&#xA;from CTE_Total_Facturado v --1656457&#xA;left join dbo.Int_Descuentos_G06 d&#xA;on v.date &gt;= d.[FROM]&#xA;and (v.date &lt; d.UNTIL or d.UNTIL is null)&#xA;and v.total_facturado &gt; d.TOTAL_BILLING&#xA;group by v.billing_id, v.date, v.total_facturado&#xA;)&#xA;select v.*&#xA;,v.quantity * p.PRICE AS total_facturado&#xA;,v.quantity * p.PRICE * (1-d.descuento)  AS total_facturado_con_descuento&#xA;,p.PRICE&#xA;,d.descuento&#xA;,case when pr.Es_lata = 'Si' then v.quantity else 0 end Cantidad_Latas&#xA;,case when pr.Medidas = 'Liter' then pr.Capacidad * v.quantity else (pr.Capacidad/1000.00) * v.quantity end Cantidad_Litros_Vendidos&#xA;--Agrego las PK de las dimension&#xA;--,pr.Product_KEY&#xA;into Fact_Ventas_G06;  &#xA;from dbo.Int_Ventas_G06 v --1.676.294&#xA;left join dbo.Int_PreciosFinal_G06 p --con inner 1.642.971 quedan sin precio&#xA;on v.product_id = p.PRODUCT_ID&#xA;and v.date &gt;= p.[FROM]&#xA;and (v.date &lt; p.UNTIL or p.UNTIL is null)&#xA;left join CTE_Descuentos d&#xA;on v.billing_id = d.billing_id&#xA;left join [datawarehouse_2025_G06].dbo.Dim_Productos_G06 pr&#xA;on v.Product_ID = pr.Product_KEY&#xA;left join [datawarehouse_2025_G06].dbo.Dim_Clientes_G06 cl&#xA;on v.customer_id = cl.CUSTOMER_KEY&#xA;left join [datawarehouse_2025_G06].dbo.Dim_Empleados_G06 em&#xA;on v.employee_id = em.EMPLOYEE_KEY&#xA;&#xA;&#xA;ALTER TABLE dbo.Fact_Ventas_G06&#xA;ADD Edad_Cliente INT;&#xA;&#xA;ALTER TABLE dbo.Fact_Ventas_G06&#xA;ADD Edad_Empleado INT;&#xA;&#xA;ALTER TABLE dbo.Fact_Ventas_G06&#xA;ADD Rango_Etario_Key INT;&#xA;&#xA;&#xA;UPDATE fv&#xA;SET Edad_Cliente = DATEDIFF(YEAR, dc.BIRTH_DATE, GETDATE()) &#xA;                   - CASE &#xA;                       WHEN MONTH(dc.BIRTH_DATE) &gt; MONTH(GETDATE()) &#xA;                            OR (MONTH(dc.BIRTH_DATE) = MONTH(GETDATE()) AND DAY(dc.BIRTH_DATE) &gt; DAY(GETDATE()))&#xA;                       THEN 1 &#xA;                       ELSE 0 &#xA;                     END&#xA;FROM dbo.Fact_Ventas_G06 fv&#xA;INNER JOIN dbo.Dim_Clientes_G06 dc ON fv.customer_id = dc.CUSTOMER_ID;&#xA;&#xA;&#xA;UPDATE fv&#xA;SET Edad_Empleado = DATEDIFF(YEAR, de.BIRTH_DATE, GETDATE())&#xA;                    - CASE &#xA;                        WHEN MONTH(de.BIRTH_DATE) &gt; MONTH(GETDATE())&#xA;                             OR (MONTH(de.BIRTH_DATE) = MONTH(GETDATE()) AND DAY(de.BIRTH_DATE) &gt; DAY(GETDATE()))&#xA;                        THEN 1&#xA;                        ELSE 0&#xA;                      END&#xA;FROM dbo.Fact_Ventas_G06 fv&#xA;INNER JOIN dbo.Dim_Empleados_G06 de ON fv.employee_id = de.EMPLOYEE_KEY;&#xA;&#xA;UPDATE fv&#xA;SET Rango_Etario_Key = dre.Rango_Etario_Key&#xA;FROM dbo.Fact_Ventas_G06 fv&#xA;INNER JOIN dbo.Dim_RangoEtario_G06 dre &#xA;    ON fv.Edad_Cliente BETWEEN dre.Edad_Min AND dre.Edad_Max;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
